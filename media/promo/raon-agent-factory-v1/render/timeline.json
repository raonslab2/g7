  "cues": [
    { "start": 0.6, "end": 3.3, "text": "AI는 이제 빠르게 답합니다." },
    { "start": 3.5, "end": 6.8, "text": "하지만 그 일이 정말 끝났는지는\n누가 확인할까요?" },
    { "start": 7.6, "end": 11.3, "text": "RAON Agent Factory는\nAI Agent를 만드는 공장이자," },
    { "start": 11.5, "end": 15.5, "text": "실제로 일하게 만드는\n운영 플랫폼입니다." },
    { "start": 16.4, "end": 20.4, "text": "AI_GCS에서는 대화하듯,\n한 문장으로 일을 맡깁니다." },
    { "start": 20.8, "end": 25.6, "text": "프로젝트와 Provider를 고르면,\n요청은 그 즉시 접수되어 기록됩니다." },
    { "start": 26.0, "end": 32.4, "text": "내 작업과 지시함, 프로젝트에서\n진행 상황을 한곳에서 봅니다." },
    { "start": 33.4, "end": 38.8, "text": "AgentOpt는 접수된 요청을\n실제 Provider 실행으로 옮깁니다." },
    { "start": 39.2, "end": 44.8, "text": "총괄이 역할을 나누면, CODEX와 CLAUDE가\n각자의 작업공간에서 동시에 일합니다." },
    { "start": 45.2, "end": 50.6, "text": "결과는 같은 대화로 돌아오고,\n서로의 작업을 교차 검토합니다." },
    { "start": 51.4, "end": 54.8, "text": "완료는 끝이 아닙니다." },
    { "start": 55.0, "end": 60.8, "text": "서버가 직접 관측한 변경 파일과 테스트,\n커밋을 증거로 남기고," },
    { "start": 61.0, "end": 66.6, "text": "Git 원격 반영과 운영 반영까지\n따로 확인합니다." },
    { "start": 67.6, "end": 72.8, "text": "RAON Hub 사이트도\n이 흐름으로 만들고 검증했습니다." },
    { "start": 73.4, "end": 79.4, "text": "모의투자 앱 MOBILE_STOCK도\n같은 방식으로 개발하고 있습니다." },
    { "start": 80.6, "end": 82.4, "text": "대화는 단순하게." },
    { "start": 82.6, "end": 84.4, "text": "실행은 강력하게." },
    { "start": 84.6, "end": 87.4, "text": "증거는 명확하게." }
  ]
}
