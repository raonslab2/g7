{
  "version": "1.0.0",
  "layout_name": "admin_travel_lab_inquiry_detail",
  "permissions": [
    "raonslab-travel_lab.inquiries.read"
  ],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:raonslab-travel_lab.admin.inquiry_detail.title",
    "description": "$t:raonslab-travel_lab.admin.inquiry_detail.description"
  },
  "transition_overlay": {
    "wait_for": [
      "inquiry"
    ]
  },
  "data_sources": [
    {
      "id": "inquiry",
      "type": "api",
      "endpoint": "/api/modules/raonslab-travel_lab/admin/inquiries/{{route?.id}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "cache": false,
      "refetchOnMount": true,
      "errorHandling": {
        "401": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        },
        "403": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        },
        "default": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        },
        "404": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        }
      },
      "fallback": {
        "data": null
      }
    }
  ],
  "slots": {
    "content": [
      {
        "id": "admin_travel_lab_inquiry_detail_content",
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "admin-page-content"
        },
        "children": [
          {
            "id": "page_header",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "flex-start justify-between gap-4 mb-4"
            },
            "children": [
              {
                "id": "page_header_left",
                "type": "basic",
                "name": "Div",
                "children": [
                  {
                    "type": "basic",
                    "name": "H1",
                    "props": {
                      "className": "page-title mb-1"
                    },
                    "text": "$t:raonslab-travel_lab.admin.inquiry_detail.title"
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-secondary text-sm"
                    },
                    "text": "$t:raonslab-travel_lab.admin.inquiry_detail.description"
                  }
                ]
              },
              {
                "id": "page_header_actions",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "flex-center gap-2 flex-shrink-0"
                },
                "children": [
                  {
                    "id": "inquiry_back_button",
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "button",
                      "className": "btn btn-secondary"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Icon",
                        "props": {
                          "name": "arrow-left",
                          "className": "text-sm"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:raonslab-travel_lab.admin.inquiry_detail.back"
                      }
                    ],
                    "actions": [
                      {
                        "type": "click",
                        "handler": "navigate",
                        "params": {
                          "path": "/admin/travel-lab/inquiries",
                          "mergeQuery": true,
                          "query": {}
                        }
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "travel_section_nav",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "flex flex-wrap gap-2 mb-6"
            },
            "children": [
              {
                "id": "travel_nav_catalog",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "px-3 py-1.5 text-sm rounded-lg text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "$t:raonslab-travel_lab.admin.nav.catalog"
                  }
                ],
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "comment": "audit:allow layout-list-context-navigate-merge-query 여행 연구소 관리 섹션 간 이동 — 목록 정체성이 달라 승계하지 않는다",
                    "params": {
                      "path": "/admin/travel-lab",
                      "mergeQuery": false,
                      "query": {}
                    }
                  }
                ]
              },
              {
                "id": "travel_nav_inquiries",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "px-3 py-1.5 text-sm rounded-lg bg-gray-900 text-white dark:bg-white dark:text-gray-900"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "$t:raonslab-travel_lab.admin.nav.inquiries"
                  }
                ],
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "comment": "audit:allow layout-list-context-navigate-merge-query 여행 연구소 관리 섹션 간 이동 — 목록 정체성이 달라 승계하지 않는다",
                    "params": {
                      "path": "/admin/travel-lab/inquiries",
                      "mergeQuery": false,
                      "query": {}
                    }
                  }
                ]
              },
              {
                "id": "travel_nav_support",
                "type": "basic",
                "name": "Button",
                "props": {
                  "type": "button",
                  "className": "px-3 py-1.5 text-sm rounded-lg text-gray-700 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-700"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "Span",
                    "text": "$t:raonslab-travel_lab.admin.nav.support"
                  }
                ],
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "comment": "audit:allow layout-list-context-navigate-merge-query 여행 연구소 관리 섹션 간 이동 — 목록 정체성이 달라 승계하지 않는다",
                    "params": {
                      "path": "/admin/travel-lab/support",
                      "mergeQuery": false,
                      "query": {}
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "lab_banner",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-4 px-4 py-3 rounded-lg bg-amber-50 text-amber-800 dark:bg-amber-900 dark:text-amber-100 text-sm"
            },
            "children": [
              {
                "type": "basic",
                "name": "Span",
                "text": "$t:raonslab-travel_lab.admin.common.lab_banner"
              }
            ]
          },
          {
            "id": "inquiry_detail_grid",
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "grid grid-cols-1 lg:grid-cols-3 gap-4"
            },
            "children": [
              {
                "id": "inquiry_summary_card",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "admin-card lg:col-span-2"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "card-title"
                    },
                    "text": "$t:raonslab-travel_lab.admin.inquiry_detail.summary"
                  },
                  {
                    "id": "row_reference",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex justify-between gap-4 py-2 border-b border-gray-100 dark:border-gray-700"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-500 dark:text-gray-400"
                        },
                        "text": "$t:raonslab-travel_lab.admin.inquiries.columns.reference"
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-900 dark:text-white text-right"
                        },
                        "text": "{{inquiry?.data?.reference ?? inquiry?.data?.id ?? ''}}"
                      }
                    ]
                  },
                  {
                    "id": "row_trip",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex justify-between gap-4 py-2 border-b border-gray-100 dark:border-gray-700"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-500 dark:text-gray-400"
                        },
                        "text": "$t:raonslab-travel_lab.admin.inquiries.columns.trip"
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-900 dark:text-white text-right"
                        },
                        "text": "{{inquiry?.data?.product_name ?? ''}}"
                      }
                    ]
                  },
                  {
                    "id": "row_departure",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex justify-between gap-4 py-2 border-b border-gray-100 dark:border-gray-700"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-500 dark:text-gray-400"
                        },
                        "text": "$t:raonslab-travel_lab.admin.inquiries.columns.departure"
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-900 dark:text-white text-right"
                        },
                        "text": "{{inquiry?.data?.departure_label ?? ''}}"
                      }
                    ]
                  },
                  {
                    "id": "row_party",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex justify-between gap-4 py-2 border-b border-gray-100 dark:border-gray-700"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-500 dark:text-gray-400"
                        },
                        "text": "$t:raonslab-travel_lab.admin.inquiries.columns.party_size"
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-900 dark:text-white text-right"
                        },
                        "text": "{{inquiry?.data?.party_size ?? 0}}"
                      }
                    ]
                  },
                  {
                    "id": "row_requester",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex justify-between gap-4 py-2 border-b border-gray-100 dark:border-gray-700"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-500 dark:text-gray-400"
                        },
                        "text": "$t:raonslab-travel_lab.admin.inquiry_detail.requester"
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-900 dark:text-white text-right"
                        },
                        "text": "{{inquiry?.data?.requester_name ?? ''}}"
                      }
                    ]
                  },
                  {
                    "id": "row_created",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex justify-between gap-4 py-2 border-b border-gray-100 dark:border-gray-700"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-500 dark:text-gray-400"
                        },
                        "text": "$t:raonslab-travel_lab.admin.inquiries.columns.created_at"
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-900 dark:text-white text-right"
                        },
                        "text": "{{inquiry?.data?.created_at ?? ''}}"
                      }
                    ]
                  },
                  {
                    "id": "row_message",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "pt-3"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "text-sm text-gray-500 dark:text-gray-400"
                        },
                        "text": "$t:raonslab-travel_lab.admin.inquiry_detail.message"
                      },
                      {
                        "type": "basic",
                        "name": "P",
                        "props": {
                          "className": "mt-1 text-sm text-gray-900 dark:text-white whitespace-pre-line break-words"
                        },
                        "text": "{{inquiry?.data?.message ?? ''}}"
                      }
                    ]
                  },
                  {
                    "id": "inquiry_product_link",
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "button",
                      "className": "btn btn-secondary btn-sm mt-4"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Icon",
                        "props": {
                          "name": "external-link-alt",
                          "className": "text-sm"
                        }
                      },
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:raonslab-travel_lab.admin.catalog.open_product_admin"
                      }
                    ],
                    "if": "{{!!inquiry?.data?.product_code}}",
                    "actions": [
                      {
                        "type": "click",
                        "handler": "navigate",
                        "comment": "audit:allow layout-list-context-navigate-merge-query 이커머스 상품 관리로 이동 — 다른 목록 클러스터",
                        "params": {
                          "path": "/admin/ecommerce/products/{{inquiry?.data?.product_code}}/edit",
                          "mergeQuery": false,
                          "query": {}
                        }
                      }
                    ]
                  }
                ]
              },
              {
                "id": "inquiry_status_card",
                "type": "basic",
                "name": "Div",
                "props": {
                  "className": "admin-card"
                },
                "children": [
                  {
                    "type": "basic",
                    "name": "H2",
                    "props": {
                      "className": "card-title"
                    },
                    "text": "$t:raonslab-travel_lab.admin.inquiry_detail.status_title"
                  },
                  {
                    "id": "current_status",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "mb-3"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "props": {
                          "className": "inline-flex items-center px-2 py-0.5 rounded text-xs font-medium {{inquiry?.data?.status === 'TEST_ACCEPTED' ? 'bg-green-100 text-green-800 dark:bg-green-800 dark:text-green-100' : inquiry?.data?.status === 'UNDER_REVIEW' ? 'bg-blue-100 text-blue-800 dark:bg-blue-800 dark:text-blue-100' : inquiry?.data?.status === 'DECLINED' || inquiry?.data?.status === 'CANCELLED' ? 'bg-gray-200 text-gray-800 dark:bg-gray-600 dark:text-gray-100' : 'bg-amber-100 text-amber-800 dark:bg-amber-800 dark:text-amber-100'}}"
                        },
                        "text": "{{inquiry?.data?.status === 'TEST_INQUIRY' ? '$t:raonslab-travel_lab.admin.inquiries.status.TEST_INQUIRY' : inquiry?.data?.status === 'UNDER_REVIEW' ? '$t:raonslab-travel_lab.admin.inquiries.status.UNDER_REVIEW' : inquiry?.data?.status === 'TEST_ACCEPTED' ? '$t:raonslab-travel_lab.admin.inquiries.status.TEST_ACCEPTED' : inquiry?.data?.status === 'DECLINED' ? '$t:raonslab-travel_lab.admin.inquiries.status.DECLINED' : inquiry?.data?.status === 'CANCELLED' ? '$t:raonslab-travel_lab.admin.inquiries.status.CANCELLED' : (inquiry?.data?.status ?? '')}}"
                      }
                    ]
                  },
                  {
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 dark:text-gray-400 mb-2"
                    },
                    "text": "$t:raonslab-travel_lab.admin.inquiry_detail.transition_hint"
                  },
                  {
                    "id": "transition_buttons",
                    "type": "basic",
                    "name": "Div",
                    "props": {
                      "className": "flex flex-wrap gap-2 mb-3"
                    },
                    "children": [
                      {
                        "id": "transition_button",
                        "type": "basic",
                        "name": "Button",
                        "props": {
                          "type": "button",
                          "className": "btn btn-sm {{_global.travelInquiryNextStatus === nextStatus ? 'btn-primary' : 'btn-secondary'}}"
                        },
                        "children": [
                          {
                            "type": "basic",
                            "name": "Span",
                            "text": "{{nextStatus === 'TEST_INQUIRY' ? '$t:raonslab-travel_lab.admin.inquiries.status.TEST_INQUIRY' : nextStatus === 'UNDER_REVIEW' ? '$t:raonslab-travel_lab.admin.inquiries.status.UNDER_REVIEW' : nextStatus === 'TEST_ACCEPTED' ? '$t:raonslab-travel_lab.admin.inquiries.status.TEST_ACCEPTED' : nextStatus === 'DECLINED' ? '$t:raonslab-travel_lab.admin.inquiries.status.DECLINED' : nextStatus === 'CANCELLED' ? '$t:raonslab-travel_lab.admin.inquiries.status.CANCELLED' : nextStatus}}"
                          }
                        ],
                        "iteration": {
                          "source": "{{inquiry?.data?.allowed_transitions ?? []}}",
                          "item_var": "nextStatus",
                          "index_var": "transitionIndex"
                        },
                        "actions": [
                          {
                            "type": "click",
                            "handler": "setState",
                            "params": {
                              "target": "global",
                              "travelInquiryNextStatus": "{{nextStatus}}"
                            }
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "terminal_hint",
                    "type": "basic",
                    "name": "P",
                    "props": {
                      "className": "text-xs text-gray-500 dark:text-gray-400 mb-3"
                    },
                    "text": "$t:raonslab-travel_lab.admin.inquiry_detail.terminal",
                    "if": "{{(inquiry?.data?.allowed_transitions ?? []).length === 0}}"
                  },
                  {
                    "type": "basic",
                    "name": "Label",
                    "props": {
                      "className": "text-sm font-medium text-gray-700 dark:text-gray-300"
                    },
                    "text": "$t:raonslab-travel_lab.admin.inquiry_detail.admin_note"
                  },
                  {
                    "id": "admin_note_input",
                    "type": "basic",
                    "name": "Textarea",
                    "props": {
                      "rows": 4,
                      "maxLength": 2000,
                      "className": "w-full mt-1 px-3 py-2 border border-gray-300 dark:border-gray-600 rounded-lg bg-white dark:bg-gray-800 text-gray-900 dark:text-white",
                      "placeholder": "$t:raonslab-travel_lab.admin.inquiry_detail.admin_note_placeholder",
                      "value": "{{_global.travelInquiryNote ?? inquiry?.data?.admin_note ?? ''}}"
                    },
                    "actions": [
                      {
                        "type": "change",
                        "handler": "setState",
                        "params": {
                          "target": "global",
                          "travelInquiryNote": "{{$event.target.value}}"
                        }
                      }
                    ]
                  },
                  {
                    "id": "inquiry_save_button",
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "button",
                      "className": "btn btn-primary w-full mt-3",
                      "disabled": "{{_global.travelInquirySaving === true || inquiry?.data?.abilities?.can_update !== true}}"
                    },
                    "children": [
                      {
                        "type": "basic",
                        "name": "Span",
                        "text": "$t:raonslab-travel_lab.admin.common.save"
                      }
                    ],
                    "actions": [
                      {
                        "type": "click",
                        "handler": "sequence",
                        "actions": [
                          {
                            "handler": "setState",
                            "params": {
                              "target": "global",
                              "travelInquirySaving": true
                            }
                          },
                          {
                            "handler": "apiCall",
                            "auth_required": true,
                            "target": "/api/modules/raonslab-travel_lab/admin/inquiries/{{route.id}}",
                            "params": {
                              "method": "PATCH",
                              "body": {
                                "status": "{{_global.travelInquiryNextStatus ?? inquiry?.data?.status}}",
                                "admin_note": "{{_global.travelInquiryNote ?? ''}}"
                              }
                            },
                            "onSuccess": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "global",
                                  "travelInquirySaving": false,
                                  "travelInquiryNextStatus": null
                                }
                              },
                              {
                                "handler": "toast",
                                "params": {
                                  "type": "success",
                                  "message": "$t:raonslab-travel_lab.admin.inquiry_detail.saved"
                                }
                              },
                              {
                                "handler": "refetchDataSource",
                                "params": {
                                  "dataSourceId": "inquiry"
                                }
                              }
                            ],
                            "onError": [
                              {
                                "handler": "setState",
                                "params": {
                                  "target": "global",
                                  "travelInquirySaving": false
                                }
                              },
                              {
                                "handler": "toast",
                                "params": {
                                  "type": "error",
                                  "message": "{{error.message}}"
                                }
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ],
            "blur_until_loaded": true
          }
        ]
      }
    ]
  },
  "init_actions": [
    {
      "handler": "setState",
      "params": {
        "target": "global",
        "travelInquiryNextStatus": null,
        "travelInquiryNote": null,
        "travelInquirySaving": false
      }
    }
  ]
}
