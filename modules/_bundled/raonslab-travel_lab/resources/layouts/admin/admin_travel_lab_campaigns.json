{
  "version": "1.0.0",
  "layout_name": "admin_travel_lab_campaigns",
  "permissions": [
    "sirsoft-page.pages.read"
  ],
  "extends": "_admin_base",
  "meta": {
    "title": "$t:raonslab-travel_lab.admin.campaigns.title",
    "description": "$t:raonslab-travel_lab.admin.campaigns.description"
  },
  "data_sources": [
    {
      "id": "campaign_pages",
      "label_key": "$t:raonslab-travel_lab.admin.campaigns.title",
      "type": "api",
      "endpoint": "/api/modules/sirsoft-page/admin/pages",
      "method": "GET",
      "auto_fetch": true,
      "auth_mode": "required",
      "comment": "native 페이지 관리자 목록. slug 필터는 native 가 부분일치(LIKE)로 처리하므로 화면은 레지스트리 두 slug 와 정확히 같은 행만 쓴다",
      "errorHandling": {
        "403": {
          "handler": "showErrorPage",
          "params": {
            "target": "content"
          }
        }
      },
      "params": {
        "filters[0][field]": "slug",
        "filters[0][operator]": "starts_with",
        "filters[0][value]": "travel-lab-campaign-",
        "per_page": 100,
        "page": "{{query.page}}"
      }
    }
  ],
  "slots": {
    "content": [
      {
        "type": "basic",
        "name": "Div",
        "props": {
          "className": "admin-page-content",
          "data-testid": "admin-travel-campaigns"
        },
        "children": [
          {
            "type": "basic",
            "name": "Div",
            "props": {
              "className": "mb-6"
            },
