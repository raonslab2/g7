{
  "version": "1.0.0",
  "layout_name": "admin_consultation_detail",
  "permissions": [
    "raonslab-product.consultations.read"
  ],
  "extends": "_admin_base",
  "meta": {
    "title": "상담 상세 / Consultation detail"
  },
  "state": {
    "note": "",
    "closeOutcome": ""
  },
  "data_sources": [
    {
      "id": "consultation",
      "label_key": "Consultation detail",
      "type": "api",
      "endpoint": "/api/modules/raonslab-product/admin/consultations/{{route.reference}}",
      "method": "GET",
      "auto_fetch": true,
      "auth_required": true,
      "loading_strategy": "progressive",
      "errorHandling": {
        "403": {
          "handler": "showErrorPage",
          "params": {"target": "content"}
        },
        "404": {
          "handler": "showErrorPage",
          "params": {"target": "content"}
        }
      },
      "fallback": {"data": null}
    }
  ],
  "slots": {
    "content": [
      {
        "id": "consultation_detail_page",
        "type": "basic",
        "name": "Div",
        "props": {"className": "admin-page-content-responsive"},
        "children": [
          {
            "id": "consultation_detail_header",
            "type": "composite",
            "name": "PageHeader",
            "props": {
              "title": "상담 상세 / Consultation detail",
              "description": "{{consultation?.data?.reference ?? ''}}"
            },
            "children": [
              {
                "id": "consultation_back_button",
                "type": "basic",
                "name": "Button",
                "props": {"type": "button", "className": "btn"},
                "actions": [
                  {
                    "type": "click",
                    "handler": "navigate",
                    "comment": "목록에서 실어 온 status/page/per_page 를 그대로 되돌려 보던 목록으로 복귀한다.",
                    "params": {
                      "path": "/admin/consultations",
                      "mergeQuery": true,
                      "query": {}
                    }
                  }
                ],
                "children": [{"type": "basic", "name": "Span", "text": "목록 / Back"}]
              }
            ]
          },
          {
            "id": "consultation_detail_loading",
            "type": "composite",
            "name": "LoadingSpinner",
            "if": "{{consultation == null || consultation?.$loading === true}}",
            "props": {
              "size": "md",
              "text": "상담 내용을 불러오는 중입니다. / Loading consultation…",
              "className": "py-10"
            }
          },
          {
            "id": "consultation_detail_error",
            "type": "basic",
            "name": "Div",
            "if": "{{consultation != null && consultation?.$loading !== true && _dataSourceErrors?.consultation != null && _dataSourceErrors?.consultation?.status !== 403 && _dataSourceErrors?.consultation?.status !== 404}}",
            "props": {"className": "mb-4"},
            "children": [
              {
                "type": "composite",
                "name": "Alert",
                "props": {
                  "type": "error",
                  "message": "상담 내용을 불러오지 못했습니다. 잠시 후 다시 시도해 주세요. / Couldn't load this consultation. Please try again."
                }
              },
              {
                "type": "basic",
                "name": "Button",
                "props": {"type": "button", "className": "btn mt-3"},
                "actions": [
                  {
                    "type": "click",
                    "handler": "refetchDataSource",
                    "params": {"dataSourceId": "consultation"}
                  }
                ],
                "children": [{"type": "basic", "name": "Span", "text": "다시 시도 / Retry"}]
              }
            ]
          },
          {
            "id": "consultation_detail_ready",
            "type": "basic",
            "name": "Div",
            "if": "{{consultation?.$loading !== true && consultation?.data?.reference != null}}",
            "children": [
              {
                "id": "consultation_contact_card",
                "type": "basic",
                "name": "Div",
                "props": {"className": "admin-card mb-4 break-words"},
                "children": [
                  {"type": "basic", "name": "H2", "props": {"className": "section-heading"}, "text": "{{consultation?.data?.contact_name ?? ''}} · {{consultation?.data?.company ?? '-'}}"},
                  {"type": "basic", "name": "P", "props": {"className": "break-all"}, "text": "Email: {{consultation?.data?.email ?? ''}}"},
                  {"type": "basic", "name": "P", "text": "Phone: {{consultation?.data?.phone ?? '-'}}"},
                  {"type": "basic", "name": "P", "text": "Service: {{consultation?.data?.service_interest ?? '-'}}"},
                  {"type": "basic", "name": "P", "text": "Status: {{consultation?.data?.status ?? ''}} · Mail: {{consultation?.data?.mail_status ?? ''}}"},
                  {"type": "basic", "name": "P", "text": "Consent: {{consultation?.data?.privacy_consent_version ?? ''}} · {{consultation?.data?.privacy_consented_at ?? ''}}"}
                ]
              },
              {
                "id": "consultation_message_card",
                "type": "basic",
                "name": "Div",
                "props": {"className": "admin-card mb-4"},
                "children": [
                  {"type": "basic", "name": "H2", "props": {"className": "section-heading"}, "text": "문의 내용 / Message"},
                  {"type": "basic", "name": "P", "props": {"className": "whitespace-pre-wrap break-words"}, "text": "{{consultation?.data?.message ?? ''}}"}
                ]
              },
              {
                "id": "consultation_read_only_notice",
                "type": "basic",
                "name": "P",
                "if": "{{consultation?.data?.abilities?.can_manage !== true}}",
                "props": {"className": "text-sm text-secondary mb-4"},
                "text": "조회 권한만 있어 상태 변경과 메모 작성은 할 수 없습니다. / You have read-only access."
              },
              {
                "id": "consultation_status_card",
                "type": "basic",
                "name": "Div",
                "if": "{{consultation?.data?.abilities?.can_manage === true}}",
                "props": {"className": "admin-card mb-4"},
                "children": [
                  {"type": "basic", "name": "H2", "props": {"className": "section-heading"}, "text": "상태 처리 / Status"},
                  {
                    "id": "consultation_status_closed",
                    "type": "basic",
                    "name": "P",
                    "if": "{{consultation?.data?.next_status == null}}",
                    "props": {"className": "text-sm text-secondary"},
                    "text": "종결된 상담입니다. / This consultation is closed."
                  },
                  {
                    "id": "consultation_close_outcome",
                    "type": "basic",
                    "name": "Input",
                    "if": "{{consultation?.data?.next_status === 'CLOSED'}}",
                    "props": {
                      "type": "text",
                      "value": "{{_local.closeOutcome ?? ''}}",
                      "maxLength": 160,
                      "aria-label": "종결 결과 / Close outcome",
                      "placeholder": "종결 결과 / Close outcome",
                      "className": "w-full mb-3"
                    },
                    "actions": [
                      {
                        "type": "change",
                        "handler": "setState",
                        "params": {"target": "local", "closeOutcome": "{{$event.target.value}}"}
                      }
                    ]
                  },
                  {
                    "id": "consultation_status_submit",
                    "type": "basic",
                    "name": "Button",
                    "if": "{{consultation?.data?.next_status != null}}",
                    "props": {
                      "type": "button",
                      "className": "btn btn-primary",
                      "disabled": "{{_global.raonConsultationStatusSaving === true || (consultation?.data?.next_status === 'CLOSED' && (_local.closeOutcome ?? '').trim() === '')}}",
                      "aria-busy": "{{_global.raonConsultationStatusSaving === true ? 'true' : 'false'}}"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "sequence",
                        "actions": [
                          {
                            "handler": "setState",
                            "params": {"target": "global", "raonConsultationStatusSaving": true}
                          },
                          {
                            "handler": "apiCall",
                            "auth_required": true,
                            "target": "/api/modules/raonslab-product/admin/consultations/{{route.reference}}/status",
                            "params": {
                              "method": "PATCH",
                              "body": {
                                "status": "{{consultation?.data?.next_status}}",
                                "close_outcome": "{{consultation?.data?.next_status === 'CLOSED' ? (_local.closeOutcome ?? '') : null}}"
                              }
                            },
                            "onSuccess": [
                              {"handler": "setState", "params": {"target": "global", "raonConsultationStatusSaving": false}},
                              {"handler": "setState", "params": {"target": "local", "closeOutcome": ""}},
                              {"handler": "refetchDataSource", "params": {"dataSourceId": "consultation"}},
                              {"handler": "toast", "params": {"type": "success", "message": "상태가 변경되었습니다. / Status updated."}}
                            ],
                            "onError": [
                              {"handler": "setState", "params": {"target": "global", "raonConsultationStatusSaving": false}},
                              {"handler": "refetchDataSource", "params": {"dataSourceId": "consultation"}},
                              {"handler": "toast", "params": {"type": "error", "message": "{{error.message ?? 'Status update failed'}}"}}
                            ]
                          }
                        ]
                      }
                    ],
                    "children": [{"type": "basic", "name": "Span", "text": "{{_global.raonConsultationStatusSaving === true ? '저장 중… / Saving…' : '다음 단계로 변경: ' + (consultation?.data?.next_status ?? '')}}"}]
                  }
                ]
              },
              {
                "id": "consultation_note_card",
                "type": "basic",
                "name": "Div",
                "if": "{{consultation?.data?.abilities?.can_manage === true}}",
                "props": {"className": "admin-card mb-4"},
                "children": [
                  {"type": "basic", "name": "H2", "props": {"className": "section-heading"}, "text": "내부 메모 / Internal note"},
                  {
                    "id": "consultation_note_input",
                    "type": "basic",
                    "name": "Textarea",
                    "props": {
                      "rows": 5,
                      "maxLength": 2000,
                      "aria-label": "내부 메모 / Internal note",
                      "value": "{{_local.note ?? ''}}",
                      "className": "w-full mb-3"
                    },
                    "actions": [
                      {
                        "type": "change",
                        "handler": "setState",
                        "params": {"target": "local", "note": "{{$event.target.value}}"}
                      }
                    ]
                  },
                  {
                    "id": "consultation_note_submit",
                    "type": "basic",
                    "name": "Button",
                    "props": {
                      "type": "button",
                      "className": "btn btn-primary",
                      "disabled": "{{_global.raonConsultationNoteSaving === true || (_local.note ?? '').trim() === ''}}",
                      "aria-busy": "{{_global.raonConsultationNoteSaving === true ? 'true' : 'false'}}"
                    },
                    "actions": [
                      {
                        "type": "click",
                        "handler": "sequence",
                        "actions": [
                          {
                            "handler": "setState",
                            "params": {"target": "global", "raonConsultationNoteSaving": true}
                          },
                          {
                            "handler": "apiCall",
                            "auth_required": true,
                            "target": "/api/modules/raonslab-product/admin/consultations/{{route.reference}}/notes",
                            "params": {"method": "POST", "body": {"note": "{{_local.note ?? ''}}"}},
                            "onSuccess": [
                              {"handler": "setState", "params": {"target": "global", "raonConsultationNoteSaving": false}},
                              {"handler": "setState", "params": {"target": "local", "note": ""}},
                              {"handler": "refetchDataSource", "params": {"dataSourceId": "consultation"}},
                              {"handler": "toast", "params": {"type": "success", "message": "메모가 저장되었습니다. / Note saved."}}
                            ],
                            "onError": [
                              {"handler": "setState", "params": {"target": "global", "raonConsultationNoteSaving": false}},
                              {"handler": "toast", "params": {"type": "error", "message": "{{error.message ?? 'Note save failed'}}"}}
                            ]
                          }
                        ]
                      }
                    ],
                    "children": [{"type": "basic", "name": "Span", "text": "{{_global.raonConsultationNoteSaving === true ? '저장 중… / Saving…' : '메모 저장 / Save note'}}"}]
                  }
                ]
              },
              {
                "id": "consultation_history_card",
                "type": "basic",
                "name": "Div",
                "props": {"className": "admin-card"},
                "children": [
                  {"type": "basic", "name": "H2", "props": {"className": "section-heading"}, "text": "변경 이력 / History"},
                  {
                    "id": "consultation_history_{{history_index}}",
                    "type": "basic",
                    "name": "Div",
                    "iteration": {
                      "source": "{{consultation?.data?.history ?? []}}",
                      "item_var": "history_item",
                      "index_var": "history_index"
                    },
                    "props": {"className": "py-3 border-b border-gray-200 dark:border-gray-700"},
                    "children": [
                      {"type": "basic", "name": "P", "text": "{{history_item.event_type ?? ''}} · {{history_item.from_status ?? '-'}} → {{history_item.to_status ?? '-'}}"},
                      {"type": "basic", "name": "P", "props": {"className": "text-sm whitespace-pre-wrap break-words"}, "text": "{{history_item.note ?? history_item.close_outcome ?? ''}}"},
                      {"type": "basic", "name": "P", "props": {"className": "text-xs text-secondary"}, "text": "{{history_item.actor?.name ?? 'system'}} · {{history_item.created_at ?? ''}}"}
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
