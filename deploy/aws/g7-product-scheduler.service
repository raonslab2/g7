[Unit]
Description=Run GNUBOARD7 product scheduler
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=oneshot
User=ubuntu
Group=www-data
WorkingDirectory=/srv/g7/current
ExecStart=/usr/bin/php8.3 artisan schedule:run --no-interaction
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
