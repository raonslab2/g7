[Unit]
Description=GNUBOARD7 product standalone nginx
Requires=g7-product-fpm.service
After=network.target g7-product-fpm.service

[Service]
Type=simple
User=ubuntu
Group=www-data
RuntimeDirectory=g7-product-web
RuntimeDirectoryMode=0755
WorkingDirectory=/srv/g7/current
ExecStartPre=/usr/sbin/nginx -t -p /srv/g7/current/ -c deploy/aws/nginx.conf
ExecStart=/usr/sbin/nginx -p /srv/g7/current/ -c deploy/aws/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
