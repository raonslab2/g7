# Install as /etc/g7-agentopt-v2/runtime.env with mode 0600.
# This runtime is exclusively for GNUBOARD7 and must not reuse the production
# AgentOpt V2 DB, workspace, attachment, service secret, or project registry.
AGENTOPT_V2_DATA_DIR=/var/lib/g7-agentopt/data
AGENTOPT_V2_DB=/var/lib/g7-agentopt/data/agentopt-v2.sqlite3
AGENTOPT_V2_WORKSPACE_ROOT=/var/lib/g7-agentopt/workspaces
AGENTOPT_V2_ATTACHMENT_ROOT=/var/lib/g7-agentopt/attachments
AGENTOPT_V2_AGENT_TOOLS_RELEASE=agent-tools-release-id
AGENTOPT_V2_AGENT_TOOLS_ROOT=/var/lib/g7-agentopt/agent-tools-releases/agent-tools-release-id/content
AGENTOPT_V2_AGENT_TOOLS_EXPECTED_COMMIT=forty-character-commit
AGENTOPT_V2_AGENT_TOOLS_EXPECTED_MANIFEST_DIGEST=sha256-manifest-digest
AGENTOPT_V2_PROJECTS_JSON='[{"project_id":"GNUBOARD7","root":"/home/mrdev/git/g7","users":[],"display_name":"GNUBOARD7 · RAON Hub"}]'
AGENTOPT_V2_PROVIDERS_JSON='[{"provider":"CODEX","profile":"CODEX_1","command":["/home/mrdev/bin/codex1","app-server","--listen","stdio://"],"available":true,"readiness":{"status":"PASS"},"sandbox":"danger-full-access","approval_policy":"never"}]'
AGENTOPT_V2_PROXY_SECRET=generate-a-new-dedicated-random-secret
