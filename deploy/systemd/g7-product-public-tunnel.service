[Unit]
Description=GNUBOARD7 isolated temporary HTTPS reverse SSH tunnel
After=network-online.target g7-product-web.service
Wants=network-online.target
Requires=g7-product-web.service
PartOf=g7-product-web.service

[Service]
Type=simple
User=mrdev
ExecStart=/usr/bin/autossh -M 0 -T \
  -o BatchMode=yes \
  -o ConnectTimeout=15 \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  -o ExitOnForwardFailure=yes \
  -o StrictHostKeyChecking=yes \
  -R 80:127.0.0.1:18770 \
  nokey@localhost.run
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
