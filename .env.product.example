APP_NAME="RAON Hub"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:18770
APP_VERSION=7.0.11
APP_LOCALE=ko
APP_FALLBACK_LOCALE=ko
APP_FAKER_LOCALE=ko_KR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=2
PHP_BINARY=/usr/bin/php8.3
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_WRITE_HOST=127.0.0.1
DB_WRITE_PORT=3306
DB_WRITE_DATABASE=g7_product
DB_WRITE_USERNAME=g7_product
DB_WRITE_PASSWORD=change-me
DB_PREFIX=g7_

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=raon-hub-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SCOUT_DRIVER=mysql-fulltext
CACHE_STORE=database
CACHE_PREFIX=raon-hub-cache-

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PREFIX=raon-hub-redis-
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
G7_UPDATE_GITHUB_URL=https://github.com/raonslab2/g7
G7_UPDATE_GITHUB_TOKEN=
G7_STATIC_CACHE=true

# RAON AI Workspace -> isolated AI_GCS/AgentOpt V2 Request API
G7_AIGCS_V2_BASE_URL=http://127.0.0.1:18771
G7_AIGCS_V2_PROXY_TOKEN=replace-with-dedicated-random-secret
G7_AIGCS_V2_PROJECT_ID=GNUBOARD7
G7_AIGCS_V2_OPERATOR_ID=g7-adapter
G7_AIGCS_V2_ORIGIN=http://127.0.0.1:18770
G7_AIGCS_V2_CONNECT_TIMEOUT=3
G7_AIGCS_V2_REQUEST_TIMEOUT=30
