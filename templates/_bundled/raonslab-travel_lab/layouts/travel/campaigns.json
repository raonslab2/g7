{
    "version": "1.0.0",
    "layout_name": "travel/campaigns",
    "extends": "_user_base",
    "meta": {
        "title": "$t:travel.meta.campaigns_title",
        "description": "$t:travel.campaigns.desc"
    },
    "data_sources": [
        {
            "id": "campaigns",
            "label_key": "$t:editor.data_source.campaigns",
            "type": "api",
            "endpoint": "/api/modules/raonslab-travel_lab/campaigns",
            "method": "GET",
            "auto_fetch": true,
            "auth_mode": "optional",
            "loading_strategy": "progressive"
        }
    ],
    "slots": {
        "content": [
            {
                "type": "basic",
                "name": "Section",
                "props": {
                    "className": "mx-auto w-full max-w-6xl px-4 py-8 md:px-6 md:py-12",
                    "data-testid": "campaigns-page",
                    "aria-labelledby": "campaigns-heading"
                },
                "children": [
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "mb-6 space-y-2"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Span",
                                "props": {
                                    "className": "inline-block rounded-full bg-dusk-50 px-3 py-1 text-xs font-bold text-dusk-600"
                                },
                                "text": "$t:travel.campaigns.eyebrow"
                            },
                            {
                                "type": "basic",
                                "name": "H1",
                                "props": {
                                    "id": "campaigns-heading",
                                    "className": "text-2xl font-black tracking-tight text-ink-900 md:text-3xl"
                                },
                                "text": "$t:travel.campaigns.title"
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "max-w-2xl text-sm text-ink-500 md:text-base"
                                },
                                "text": "$t:travel.campaigns.desc"
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "grid gap-4 md:grid-cols-2",
                            "aria-busy": "true",
                            "aria-live": "polite",
                            "data-testid": "campaigns-loading"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "overflow-hidden rounded-3xl border border-slate-200 bg-white"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "h-36 animate-pulse bg-slate-100"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-2 p-5"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "h-4 w-2/3 animate-pulse rounded bg-slate-100"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "h-3 w-full animate-pulse rounded bg-slate-100"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "overflow-hidden rounded-3xl border border-slate-200 bg-white"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "h-36 animate-pulse bg-slate-100"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Div",
                                        "props": {
                                            "className": "space-y-2 p-5"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "h-4 w-2/3 animate-pulse rounded bg-slate-100"
                                                }
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "h-3 w-full animate-pulse rounded bg-slate-100"
                                                }
                                            }
                                        ]
                                    }
                                ]
                            }
                        ],
                        "if": "{{campaigns === undefined && !_dataSourceErrors?.campaigns}}"
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "props": {
                            "className": "flex flex-col items-center gap-3 rounded-2xl border border-rose-200 bg-rose-50 px-6 py-10 text-center",
                            "role": "alert",
                            "data-testid": "campaigns-error"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Icon",
                                "props": {
                                    "name": "exclamation-triangle",
                                    "className": "text-2xl text-rose-500",
                                    "aria-hidden": "true"
                                }
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "text-sm font-semibold text-rose-700"
                                },
                                "text": "$t:travel.campaigns.error"
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "text-xs text-rose-600"
                                },
                                "text": "$t:travel.common.error_hint"
                            },
                            {
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "className": "inline-flex items-center gap-2 rounded-xl bg-white px-4 py-2 text-sm font-semibold text-rose-700 ring-1 ring-rose-200 hover:bg-rose-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-rose-400",
                                    "data-testid": "campaigns-retry"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "rotate-left",
                                            "className": "text-sm",
                                            "aria-hidden": "true"
                                        }
                                    },
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:travel.common.retry"
                                    }
                                ],
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "refetchDataSource",
                                        "params": {
                                            "dataSourceId": "campaigns"
                                        }
                                    }
                                ]
                            }
                        ],
                        "if": "{{!campaigns && !!_dataSourceErrors?.campaigns}}"
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "if": "{{!!campaigns && (campaigns?.data?.items ?? []).length === 0}}",
                        "props": {
                            "className": "flex flex-col items-center gap-3 rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center",
                            "data-testid": "campaigns-empty"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "flex h-14 w-14 items-center justify-center rounded-full bg-raon-50 text-raon-600"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Icon",
                                        "props": {
                                            "name": "map-marker-alt",
                                            "className": "text-2xl",
                                            "aria-hidden": "true"
                                        }
                                    }
                                ]
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "text-base font-semibold text-ink-900"
                                },
                                "text": "$t:travel.campaigns.empty_title"
                            },
                            {
                                "type": "basic",
                                "name": "P",
                                "props": {
                                    "className": "max-w-md text-sm text-ink-500"
                                },
                                "text": "$t:travel.campaigns.empty_desc"
                            },
                            {
                                "type": "basic",
                                "name": "Button",
                                "props": {
                                    "type": "button",
                                    "className": "inline-flex items-center justify-center gap-2 rounded-xl bg-raon-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-raon-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-raon-400 focus-visible:ring-offset-2"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Span",
                                        "text": "$t:travel.campaigns.browse_all"
                                    }
                                ],
                                "actions": [
                                    {
                                        "type": "click",
                                        "handler": "navigate",
                                        "params": {
                                            "path": "/travel/search"
                                        }
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "type": "basic",
                        "name": "Div",
                        "if": "{{(campaigns?.data?.items ?? []).length > 0}}",
                        "props": {
                            "className": "grid gap-4 md:grid-cols-2",
                            "data-testid": "campaigns-results"
                        },
                        "children": [
                            {
                                "type": "basic",
                                "name": "Div",
                                "props": {
                                    "className": "h-full"
                                },
                                "children": [
                                    {
                                        "type": "basic",
                                        "name": "Button",
                                        "props": {
                                            "type": "button",
                                            "className": "group flex h-full w-full flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white text-left shadow-sm transition hover:-translate-y-0.5 hover:border-raon-300 hover:shadow-md focus:outline-none focus-visible:ring-2 focus-visible:ring-raon-400 focus-visible:ring-offset-2",
                                            "data-testid": "campaign-card",
                                            "aria-label": "{{campaign.title ?? ''}}"
                                        },
                                        "children": [
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "relative h-36 w-full overflow-hidden bg-raon-50 md:h-44"
                                                },
                                                "children": [
                                                    {
                                                        "type": "composite",
                                                        "name": "ScenicArt",
                                                        "props": {
                                                            "variant": "{{campaign.art_variant ?? null}}",
                                                            "seed": "{{campaign.slug ?? ''}}",
                                                            "className": "h-full w-full transition duration-500 group-hover:scale-105"
                                                        }
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-semibold text-raon-700 shadow-sm"
                                                        },
                                                        "text": "{{$t('travel.facets.theme.' + (campaign.theme ?? ''))}}"
                                                    }
                                                ]
                                            },
                                            {
                                                "type": "basic",
                                                "name": "Div",
                                                "props": {
                                                    "className": "flex flex-1 flex-col gap-2 p-5"
                                                },
                                                "children": [
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "text-xs font-bold uppercase tracking-wide text-dusk-600"
                                                        },
                                                        "text": "$t:travel.campaigns.eyebrow"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "H3",
                                                        "props": {
                                                            "className": "text-lg font-bold leading-snug text-ink-900 break-words group-hover:text-raon-700"
                                                        },
                                                        "text": "{{campaign.title ?? ''}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "P",
                                                        "props": {
                                                            "className": "line-clamp-3 text-sm text-ink-500 break-words"
                                                        },
                                                        "text": "{{campaign.excerpt ?? ''}}"
                                                    },
                                                    {
                                                        "type": "basic",
                                                        "name": "Span",
                                                        "props": {
                                                            "className": "mt-auto inline-flex items-center gap-1 pt-2 text-sm font-semibold text-raon-700"
                                                        },
                                                        "children": [
                                                            {
                                                                "type": "basic",
                                                                "name": "Span",
                                                                "text": "$t:travel.campaigns.view"
                                                            },
                                                            {
                                                                "type": "basic",
                                                                "name": "Icon",
                                                                "props": {
                                                                    "name": "chevron-right",
                                                                    "className": "text-xs",
                                                                    "aria-hidden": "true"
                                                                }
                                                            }
                                                        ]
                                                    }
                                                ]
                                            }
                                        ],
                                        "actions": [
                                            {
                                                "type": "click",
                                                "handler": "navigate",
                                                "params": {
                                                    "path": "{{campaign.path}}"
                                                }
                                            }
                                        ]
                                    }
                                ],
                                "iteration": {
                                    "source": "{{campaigns?.data?.items ?? []}}",
                                    "item_var": "campaign"
                                }
                            }
                        ]
                    }
                ]
            }
        ]
    }
}
