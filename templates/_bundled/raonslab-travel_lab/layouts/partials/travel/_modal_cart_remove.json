{
    "meta": {
        "is_partial": true,
        "description": "여행 장바구니 항목 빼기 확인"
    },
    "id": "travel_cart_remove_modal",
    "type": "composite",
    "name": "Modal",
    "props": {
        "title": "$t:travel.cart.remove_title",
        "size": "sm"
    },
    "children": [
        {
            "type": "basic",
            "name": "Div",
            "props": {
                "className": "space-y-4"
            },
            "children": [
                {
                    "type": "basic",
                    "name": "P",
                    "props": {
                        "className": "text-sm text-ink-700"
                    },
                    "text": "$t:travel.cart.remove_desc|title={{_global.travelCartRemoveTarget?.title ?? ''}}"
                },
                {
                    "type": "basic",
                    "name": "Div",
                    "props": {
                        "className": "flex justify-end gap-2"
                    },
                    "children": [
                        {
                            "type": "basic",
                            "name": "Button",
                            "props": {
                                "type": "button",
                                "className": "inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-ink-700 transition hover:border-raon-400 hover:text-raon-700 disabled:cursor-not-allowed disabled:opacity-50",
                                "disabled": "{{!!_global.travelCartRemoving}}"
                            },
                            "text": "$t:travel.common.cancel",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "closeModal"
                                }
                            ]
                        },
                        {
                            "type": "basic",
                            "name": "Button",
                            "props": {
                                "type": "button",
                                "className": "inline-flex items-center justify-center rounded-xl bg-rose-600 px-5 py-3 text-sm font-semibold text-white hover:bg-rose-700 disabled:opacity-50",
                                "disabled": "{{!!_global.travelCartRemoving}}",
                                "data-testid": "cart-remove-confirm"
                            },
                            "text": "$t:travel.cart.remove_confirm",
                            "actions": [
                                {
                                    "type": "click",
                                    "handler": "sequence",
                                    "actions": [
                                        {
                                            "handler": "setState",
                                            "params": {
                                                "target": "global",
                                                "travelCartRemoving": true
                                            }
                                        },
                                        {
                                            "handler": "apiCall",
                                            "auth_mode": "required",
                                            "target": "/api/modules/raonslab-travel_lab/cart/{{_global.travelCartRemoveTarget?.id}}",
                                            "params": {
                                                "method": "DELETE"
                                            },
                                            "onSuccess": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "travelCartRemoving": false,
                                                        "travelCartRemoveTarget": null
                                                    }
                                                },
                                                {
                                                    "handler": "closeModal"
                                                },
                                                {
                                                    "handler": "refetchDataSource",
                                                    "params": {
                                                        "dataSourceId": "cart"
                                                    }
                                                },
                                                {
                                                    "handler": "refetchDataSource",
                                                    "params": {
                                                        "dataSourceId": "travel_cart_badge"
                                                    }
                                                },
                                                {
                                                    "handler": "toast",
                                                    "params": {
                                                        "type": "success",
                                                        "message": "$t:travel.cart.removed_toast"
                                                    }
                                                }
                                            ],
                                            "onError": [
                                                {
                                                    "handler": "setState",
                                                    "params": {
                                                        "target": "global",
                                                        "travelCartRemoving": false
                                                    }
                                                },
                                                {
                                                    "handler": "toast",
                                                    "params": {
                                                        "type": "error",
                                                        "message": "{{error.message ?? '$t:travel.cart.remove_failed'}}"
                                                    }
                                                }
                                            ]
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
